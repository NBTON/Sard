# Local-only artifacts that must never ship to Vercel.
// Local vector cache (locked native files break the uploader; serverless
// uses the bundled static index for zero-cold-start retrieval instead).
data/zvec
// Generated runtime output + run records (ephemeral, instance-local).
output
.runs
tmp
scratch
// Local tooling state and logs.
.claude-flow
.swarm
.zed
.pytest_cache
.ruff_cache
*.log
.venv
__pycache__
