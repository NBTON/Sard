# Sard production/demo environment. Copy to .env; never commit .env.
# The app prefers live execution. The exact hero query can fall back to the
# packaged, visibly labelled cache after a deadline or recoverable live failure.

SARD_AUTO_DEMO_FALLBACK=true
SARD_DEMO_FALLBACK_TIMEOUT_SECONDS=45
SARD_OUTPUT_ROOT=output

# Production / Serverless Persistent Artifact Storage Configuration
# When running on Vercel or cloud environments, configure Blob or Object storage credentials.
# Local FileSystem storage is used automatically in development and tests.
# BLOB_READ_WRITE_TOKEN=
# SARD_STORAGE_BUCKET=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=me-central-1

# Streamlit server defaults suitable for Community Cloud / Spaces.
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Required for live mode. Leave blank only when intentionally rehearsing the
# packaged fallback. Configure this as a platform secret, never in git.
# Hosted NVIDIA API Catalog uses NVIDIA_API_KEY. For self-hosted NIM, set the
# relevant base URL and leave the key empty when the deployment does not need it.

MODEL_PROVIDER=nvidia
MODEL_NAME=nemotron-3-ultra-550b-a55b
MODEL_TEMPERATURE=0.2

NVIDIA_API_KEY=

# Independent endpoints are supported for hosted gateways or self-hosted NIM.
# NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_RERANK_BASE_URL=https://integrate.api.nvidia.com/v1

# Generation: primary -> fallback 1 -> fallback 2 -> extractive fallback.
NVIDIA_CHAT_MODEL_PRIMARY=nemotron-3-ultra-550b-a55b
NVIDIA_CHAT_MODEL_FALLBACK_1=nemotron-3-super-120b-a12b
NVIDIA_CHAT_MODEL_FALLBACK_2=qwen3-next-80b-a3b-instruct

# Query rewriting: primary -> fallback 1 -> fallback 2 -> deterministic Arabic normalization.
NVIDIA_QUERY_MODEL_PRIMARY=nemotron-3-nano-30b-a3b
NVIDIA_QUERY_MODEL_FALLBACK_1=nvidia-nemotron-nano-9b-v2
NVIDIA_QUERY_MODEL_FALLBACK_2=llama-3.1-8b-instruct

# Embeddings. A different model must use a separately rebuilt collection.
NVIDIA_EMBEDDING_MODEL_PRIMARY=nemotron-3-embed-1b
NVIDIA_EMBEDDING_MODEL_FALLBACK=nv-embed-v1

# Reranking: NVIDIA reranker -> RRF -> dense -> full text.
NVIDIA_RERANK_MODEL_PRIMARY=rerank-qa-mistral-4b

# Vision & Multimodal
NVIDIA_VISION_MODEL_PRIMARY=muse-glimmer-30b
NVIDIA_VISION_MODEL_FALLBACK_1=llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_VISION_MODEL_FALLBACK_2=nemotron-nano-12b-v2-vl

# Multimodal & Vision API (DashScope / Qwen-VL / Omni for visual analysis, OCR, and audio transcription)
DASHSCOPE_API_KEY=

# Request/fallback controls.
NVIDIA_REQUEST_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=2

# Local RAG collection and candidate budgets.
ZVEC_COLLECTION_PATH=data/zvec/sard
RAG_DENSE_CANDIDATES=30
RAG_FTS_CANDIDATES=30
RAG_FUSED_CANDIDATES=20
RAG_FINAL_TOP_K=6
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_FTS=true
RAG_ENABLE_RERANK=true

# Optional live smoke test. Never required for the offline suite.
RAG_LIVE_SMOKE=false

# OpenRouter (optional primary or fallback). Keep empty until rotated key is provisioned.
# Never commit real credentials; configure as platform secret.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLE_FREE_ONLY=true

# Parallel Search & Extract API (live web retrieval for fresh / out-of-corpus cultural questions)
# REQUIRED for live web search. When empty/unset, parallel_search/parallel_extract
# fail closed (return [] and set web_unavailable_warning=true); no hardcoded dev
# key is used. See sard/agent/tools/cultural_tools.py:_resolve_parallel_api_key.
# Rotate any previously committed dev key and add CI grep gate: `grep -R "dxl5" --fail`.
PARALLEL_API_KEY=
PARALLEL_SEARCH_BASE_URL=https://api.parallel.ai/v1beta
